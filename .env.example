# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSAPI_KEY=
# Real-time quotes for the price monitor (free key at finnhub.io)
FINNHUB_API_KEY=
# SEC EDGAR requires a User-Agent identifying you: "Name contact-email"
SEC_USER_AGENT=Your Name you@example.com

# Local: SQLite file. Railway: set automatically when you add a PostgreSQL service.
DATABASE_URL=sqlite:///local.db
ENVIRONMENT=development

# --- Recommended in production ---------------------------------------------
# Shared secret required as the X-API-Key header on endpoints that spend Claude credits.
API_ACCESS_KEY=
CORS_ORIGINS=*

# --- Budget (US/Eastern day) ---------------------------------------------
# DAILY_BUDGET_USD=5
# MEETING_RESERVE_USD=1.5       # kept free for the daily meeting until it has run
# ASK_RESERVE_USD=0.5           # kept free for your /ask questions

# --- Models -----------------------------------------------------------------
# DEEP_MODEL=claude-opus-5-5     # deep dives
# LIGHT_MODEL=claude-sonnet-5-5  # thesis updates, meetings, /ask
# RESEARCH_EFFORT=high
# LIGHT_EFFORT=medium
# ASK_EFFORT=low

# --- Monitoring -------------------------------------------------------------
# PRICE_CHECK_MINUTES=30
# PRICE_MOVE_TRIGGER_PCT=5
# THESIS_COOLDOWN_HOURS=3
# DEEP_DIVE_MIN_GAP_MINUTES=60
# RESEARCH_HOURS_START=5         # autonomous research only spends 5am-10pm ET
# RESEARCH_HOURS_END=22
# MEETING_HOUR=16
# MEETING_MINUTE=30
# ENABLE_SCHEDULER=true         # set false on the web service if you run the separate worker
# COVERAGE_DIR=coverage         # disk mirror of the per-ticker files
# SEC_SECTION_CHAR_LIMIT=40000
# ALPHAVANTAGE_PEER_BUDGET=6
# LOG_LEVEL=INFO

# --- SMS price alerts (Twilio) ----------------------------------------------
# Texts every number in ALERT_PHONE_NUMBERS when a covered ticker moves >= ALERT_MOVE_PCT today
# (again at each further multiple: 5%, 10%, 15%...). Leave unset to disable.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567          # your Twilio number (or set TWILIO_MESSAGING_SERVICE_SID)
# ALERT_PHONE_NUMBERS=+15557654321          # comma-separated, E.164 format
# ALERT_MOVE_PCT=5
# SMS_ALERTS_ENABLED=true

# --- Voice (optional) ---------------------------------------------------------
# Agent voices (text-to-speech) and your voice input (Scribe speech-to-text) both use this one key.
# Without it, voice is hidden.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# VOICE_DAILY_CHAR_LIMIT=40000   # fresh TTS characters per day (cached replays are free)
# VOICE_MAX_CHARS=2400           # per clip; longer answers are cut at a sentence end
# Swap a desk's voice with any ElevenLabs voice ID:
# ELEVENLABS_VOICE_MACRO=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_VOICE_FINTECH=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_INTERNET=IKne3meq5aSn9XLyUdCD
# ELEVENLABS_VOICE_AI=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_VOICE_CHAIR=onwK4e9ZLuTAKqWW03F8
